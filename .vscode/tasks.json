{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "xslt",
            "label": "Generar tabla Ranking",
            "saxonJar": "${config:XSLT.tasks.saxonJar}",
            "xsltFile": "${workspaceFolder}/Ranking.xsl",
            "xmlSource": "${workspaceFolder}/Ranking.xml",
            "resultPath": "${workspaceFolder}/Ranking.html",
            "messageEscaping": "adaptive",
            "allowSyntaxExtensions40": "auto",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}